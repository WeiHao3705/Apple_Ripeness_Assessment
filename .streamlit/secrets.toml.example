# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" box. Required for Live Camera to connect on networks that block
# or symmetrically NAT the WebRTC media path (most office / campus Wi-Fi).
#
# Any TURN provider works: Twilio Network Traversal Service, Metered,
# Cloudflare Calls, or your own coturn. Include a TCP/TLS URL as well as UDP
# so the stream still connects where UDP is blocked.
TURN_URL = "turn:your-turn-host:3478?transport=udp,turn:your-turn-host:3478?transport=tcp,turns:your-turn-host:5349?transport=tcp"
TURN_USERNAME = "your-username"
TURN_CREDENTIAL = "your-credential"
